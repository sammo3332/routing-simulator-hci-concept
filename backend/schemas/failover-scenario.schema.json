{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/failover-scenario-1.0.json",
  "title": "Failover Routing Visualization Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "scenario_id", "topology", "routing", "failures"],
  "properties": {
    "format_version": {"const": "1.0"},
    "scenario_id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "topology": {"$ref": "#/$defs/topology"},
    "routing": {"$ref": "#/$defs/routing"},
    "failures": {"$ref": "#/$defs/failures"},
    "search_configuration": {"$ref": "#/$defs/search"},
    "routing_snapshot": {"$ref": "#/$defs/snapshot"},
    "visualization": {"$ref": "#/$defs/visualization"},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology_id", "directed", "multigraph", "nodes", "edges"],
      "properties": {
        "topology_id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "source": {"type": "string"},
        "directed": {"type": "boolean"},
        "multigraph": {"type": "boolean"},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/node"}
        },
        "edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/edge"}
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"}
          }
        },
        "attributes": {"type": "object", "additionalProperties": true}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "weight": {"type": "number", "minimum": 0, "default": 1},
        "attributes": {"type": "object", "additionalProperties": true}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "target_node_id", "weight_mode", "tie_breaker"],
      "properties": {
        "strategy": {"const": "deterministic_shortest_path"},
        "target_node_id": {"type": "string", "minLength": 1},
        "weight_mode": {"enum": ["hop_count", "edge_weight"]},
        "tie_breaker": {"const": "lexicographic_node_and_edge_id"}
      }
    },
    "failures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failed_edge_ids"],
      "properties": {
        "failed_edge_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "origin": {"enum": ["manual", "automatic_search", "import"]}
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_k", "stop_on_first"],
      "properties": {
        "max_k": {"type": "integer", "minimum": 1},
        "stop_on_first": {"const": true}
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_ids", "edge_ids", "total_weight"],
      "properties": {
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "edge_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "total_weight": {"type": "number", "minimum": 0}
      }
    },
    "pathMap": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_paths",
        "current_paths",
        "affected_node_ids",
        "changed_node_ids"
      ],
      "properties": {
        "baseline_paths": {"$ref": "#/$defs/pathMap"},
        "current_paths": {"$ref": "#/$defs/pathMap"},
        "affected_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "changed_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "visualization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show_baseline_routes": {"type": "boolean"},
        "show_current_routes": {"type": "boolean"},
        "show_labels": {"type": "boolean"}
      }
    }
  }
}
