<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="d0" for="node" attr.name="label" attr.type="string"/>
  <key id="d1" for="node" attr.name="Longitude" attr.type="double"/>
  <key id="d2" for="node" attr.name="Latitude" attr.type="double"/>
  <key id="d3" for="edge" attr.name="weight" attr.type="double">
    <default>1.0</default>
  </key>
  <key id="d4" for="graph" attr.name="name" attr.type="string"/>
  <graph id="G" edgedefault="undirected">
    <data key="d4">graphml-mini</data>
    <node id="A">
      <data key="d0">Aachen</data>
      <data key="d1">6.0839</data>
      <data key="d2">50.7753</data>
    </node>
    <node id="B">
      <data key="d0">Bonn</data>
      <data key="d1">7.0982</data>
      <data key="d2">50.7374</data>
    </node>
    <node id="T">
      <data key="d0">Dortmund</data>
      <data key="d1">7.4653</data>
      <data key="d2">51.5136</data>
    </node>
    <edge id="A_B" source="A" target="B"><data key="d3">2.0</data></edge>
    <edge id="B_T" source="B" target="T"><data key="d3">3.0</data></edge>
    <edge id="A_T" source="A" target="T"><data key="d3">8.0</data></edge>
  </graph>
</graphml>
